# PostgreSQL connection string for the ORVA application database.
# Example: postgresql://orva_app:CHANGE_ME@127.0.0.1:5432/orva?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/orva?schema=public"

# Authentication is not enabled yet. Configure secrets only after the auth module
# is implemented; do not use demo identities in production.

# Optional: first tenant administrator bootstrap.
# Set these only for the initial seed, run pnpm db:seed once, then remove the password.
ORVA_BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
ORVA_BOOTSTRAP_ADMIN_PASSWORD="REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS"
