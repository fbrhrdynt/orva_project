# PostgreSQL connection string for the ORVA application database.
# Example: postgresql://orva_app:CHANGE_ME@127.0.0.1:5432/orva?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/orva?schema=public"

