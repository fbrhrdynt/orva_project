generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  status      TenantStatus @default(ACTIVE)
  memberships TenantMembership[]
  companies   Company[]
  roles       Role[]
  auditEvents AuditEvent[]
  customFields CustomFieldDefinition[]
  itemCategories ItemCategory[]
  unitsOfMeasure UnitOfMeasure[]
  items Item[]
  warehouses Warehouse[]

  customers Customer[]
  suppliers Supplier[]


  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  goodsReceipts GoodsReceipt[]
  purchaseOrders PurchaseOrder[]
  purchaseRequisitions PurchaseRequisition[]
}

model Company {
  id          String      @id @default(cuid())
  tenantId    String
  code        String
  name        String
  legalName   String?
  taxId       String?
  currency    String      @default("IDR")
  isActive    Boolean     @default(true)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units       BusinessUnit[]
  items       Item[]
  warehouses  Warehouse[]

  customers   Customer[]
  suppliers   Supplier[]


  memberships MembershipCompanyAccess[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  purchaseOrders PurchaseOrder[]
  purchaseRequisitions PurchaseRequisition[]
  goodsReceipts GoodsReceipt[]
}

model Item {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String
  categoryId  String?
  uomId       String
  sku         String
  name        String
  description String?
  itemType    String
  standardCost Decimal? @db.Decimal(20, 4)
  isStockItem Boolean  @default(true)
  isPurchase  Boolean  @default(true)
  isSales     Boolean  @default(true)
  isActive    Boolean  @default(true)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category    ItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  uom         UnitOfMeasure @relation(fields: [uomId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, sku])
  @@index([tenantId, companyId, isActive])
  @@index([tenantId, name])
  purchaseRequisitionLines PurchaseRequisitionLine[]
  purchaseOrderLines PurchaseOrderLine[]
}

model ItemCategory {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, name])
  purchaseRequisitionLines PurchaseRequisitionLine[]
  purchaseOrderLines PurchaseOrderLine[]
}

model Warehouse {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String
  businessUnitId String?
  code        String
  name        String
  address     String?
  isActive    Boolean  @default(true)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, code])
  @@index([tenantId, companyId, isActive])
}

model Customer {
  id             String   @id @default(cuid())
  tenantId       String
  companyId      String
  code           String
  name           String
  legalName      String?
  taxId          String?
  email          String?
  phone          String?
  billingAddress String?
  city           String?
  country        String   @default("Indonesia")
  currency       String   @default("IDR")
  paymentTermDays Int     @default(30)
  creditLimit    Decimal? @db.Decimal(20, 2)
  isActive       Boolean  @default(true)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, code])
  @@index([tenantId, companyId, isActive])
  @@index([tenantId, name])
}

model Supplier {
  id             String   @id @default(cuid())
  tenantId       String
  companyId      String
  code           String
  name           String
  legalName      String?
  taxId          String?
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String   @default("Indonesia")
  currency       String   @default("IDR")
  paymentTermDays Int     @default(30)
  isActive       Boolean  @default(true)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, code])
  @@index([tenantId, companyId, isActive])
  @@index([tenantId, name])
}

model PurchaseRequisition {
  id             String @id @default(cuid())
  tenantId       String
  companyId      String
  documentNumber String
  requestedById  String
  requestedAt    DateTime @default(now())
  requiredAt     DateTime?
  purpose        String?
  status         ProcurementDocumentStatus @default(DRAFT)
  priority       ProcurementPriority @default(NORMAL)
  currency       String @default("IDR")
  notes          String?
  submittedAt    DateTime?
  approvedAt     DateTime?
  approvedById   String?
  rejectedAt     DateTime?
  rejectedById   String?
  rejectionReason String?
  lines          PurchaseRequisitionLine[]
  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company        Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, documentNumber])
  @@index([tenantId, companyId, status, requestedAt])
  @@index([tenantId, requestedById])
}

model PurchaseRequisitionLine {
  id             String @id @default(cuid())
  requisitionId  String
  lineNumber     Int
  itemId         String?
  description    String
  quantity       Decimal @db.Decimal(20, 4)
  item           Item? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  uomCode        String
  estimatedPrice Decimal? @db.Decimal(20, 4)
  currency       String @default("IDR")
  requisition    PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([requisitionId, lineNumber])
}

model PurchaseOrder {
  id                String @id @default(cuid())
  tenantId          String
  companyId         String
  supplierId        String
  documentNumber    String
  documentDate      DateTime @default(now())
  expectedAt        DateTime?
  currency          String @default("IDR")
  exchangeRate      Decimal @default(1) @db.Decimal(20, 8)
  status            ProcurementDocumentStatus @default(DRAFT)
  priority          ProcurementPriority @default(NORMAL)
  paymentTermDays   Int @default(30)
  supplierReference String?
  deliveryAddress   String?
  notes             String?
  subtotal          Decimal @default(0) @db.Decimal(20, 4)
  discountTotal     Decimal @default(0) @db.Decimal(20, 4)
  taxTotal          Decimal @default(0) @db.Decimal(20, 4)
  grandTotal        Decimal @default(0) @db.Decimal(20, 4)
  submittedAt       DateTime?
  approvedAt        DateTime?
  approvedById      String?
  rejectedAt        DateTime?
  rejectedById      String?
  rejectionReason   String?
  lines             PurchaseOrderLine[]

  tenant            Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company           Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier          Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, documentNumber])
  @@index([tenantId, companyId, status, documentDate])
  @@index([tenantId, supplierId, documentDate])
  goodsReceipts GoodsReceipt[]
}

model PurchaseOrderLine {
  id             String @id @default(cuid())
  purchaseOrderId String
  lineNumber     Int
  itemId         String?
  description    String
  quantity       Decimal @db.Decimal(20, 4)
  receivedQty    Decimal @default(0) @db.Decimal(20, 4)
  goodsReceiptLines GoodsReceiptLine[]
  uomCode        String
  unitPrice      Decimal @db.Decimal(20, 4)
  discountRate   Decimal @default(0) @db.Decimal(9, 4)
  taxRate        Decimal @default(0) @db.Decimal(9, 4)
  lineSubtotal   Decimal @db.Decimal(20, 4)
  lineTax        Decimal @db.Decimal(20, 4)
  lineTotal      Decimal @db.Decimal(20, 4)
  item           Item? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  purchaseOrder  PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([purchaseOrderId, lineNumber])
}

model GoodsReceipt {
  id                  String @id @default(cuid())
  tenantId            String
  companyId           String
  purchaseOrderId     String
  documentNumber      String
  receivedAt          DateTime @default(now())
  receivedById        String
  warehouseId         String
  supplierDeliveryNote String?
  notes               String?
  lines               GoodsReceiptLine[]
  tenant              Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company             Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  purchaseOrder       PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse           Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, documentNumber])
  @@index([tenantId, companyId, receivedAt])
  @@index([tenantId, purchaseOrderId])
}

model GoodsReceiptLine {
  id                 String @id @default(cuid())
  goodsReceiptId     String
  purchaseOrderLineId String
  quantity           Decimal @db.Decimal(20, 4)
  notes              String?
  goodsReceipt       GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine  PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  createdAt          DateTime @default(now())

  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
}
